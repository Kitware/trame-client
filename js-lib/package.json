    "jsdom": "^27.4.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.11",
    "vite-plugin-dts": "^5.1.0",
