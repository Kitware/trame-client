{
  "name": "@kitware/trame",
  "version": "1.0.0",
  "license": "MIT",
  "main": "./dist/trame.umd.js",
  "unpkg": "./dist/trame.umd.js",
  "module": "./dist/trame.mjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kitware/trame-client.git",
    "directory": "js-lib"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build --emptyOutDir",
    "debug": "vite build --sourcemap -m dev",
    "lint": "eslint . --ext .js --fix --ignore-path .gitignore --ignore-pattern public",
    "typecheck": "tsc --noEmit --strict src/**/*.d.ts"
  },
  "dependencies": {
    "@kitware/wslink": "^2.5.6"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.4.0",
    "@types/node": "^25.6.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.11"
  },
  "files": [
    "dist/**/*",
    "src/**/*"
  ]
}
